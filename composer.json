{
    "name": "maatrics/livekit-server-sdk-php",
    "description": "LiveKit server SDK for PHP — room management, egress, ingress, SIP, agent dispatch, WhatsApp&Twilio connectors, access tokens and webhooks",
    "keywords": [
        "livekit",
        "webrtc",
        "sdk",
        "video",
        "sip",
        "egress"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Yasin Durmuş"
        }
    ],
    "homepage": "https://github.com/maatrics/livekit-server-sdk-php",
    "support": {
        "issues": "https://github.com/maatrics/livekit-server-sdk-php/issues",
        "source": "https://github.com/maatrics/livekit-server-sdk-php"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "google/protobuf": "^5.36",
        "firebase/php-jwt": "^7.1",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^8.2",
        "guzzlehttp/psr7": "^3.1",
        "laravel/pint": "^1.24",
        "nyholm/psr7": "^1.8.2",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.1"
    },
    "conflict": {
        "ext-protobuf": "<5.34"
    },
    "suggest": {
        "ext-protobuf": "Significantly faster protobuf serialization; the pure-PHP runtime is used otherwise. Must be 5.34 or newer — the extension shadows google/protobuf's classes, and before 5.34 its GPBUtil has no compatibleInt64()",
        "ext-bcmath": "Required by the pure-PHP protobuf runtime for JSON deserialization of 64-bit values"
    },
    "autoload": {
        "psr-4": {
            "LiveKit\\": "src/",
            "GPBMetadata\\LiveKit\\": "metadata/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LiveKit\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true,
        "platform": {}
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "pint --test",
        "refactor": "rector process --dry-run --clear-cache",
        "fix": "pint",
        "generate-protos": "bin/generate-protos.sh",
        "check-protocol": "bin/check-protocol-version.sh"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
